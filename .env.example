# Environment Configuration
NODE_ENV=development
PORT=5000
DOMAIN=localhost

# Database - Local Development
MONGODB_URI=mongodb://localhost:27017/academy-multi-m

# Database - MongoDB Atlas (Production) - Uncomment and replace with your Atlas URI
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/academy-multi-m?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d
SESSION_SECRET=your_session_secret_key_change_this_in_production

# Client URLs
CLIENT_URL=http://localhost:5173
MOBILE_CLIENT_URL=http://localhost:19006
ADMIN_PANEL_URL=http://localhost:3001

# Email Configuration (Optional)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM=Swim Academy <noreply@swimacademy.com>

# Cloudinary Configuration (Optional)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Security
UPLOAD_MAX_FILE_SIZE=50mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
BCRYPT_ROUNDS=12

# Admin Default Credentials
DEFAULT_ADMIN_EMAIL=admin@swimacademy.com
DEFAULT_ADMIN_PASSWORD=Admin123!
DEFAULT_ADMIN_PHONE=+201000000000

# Support Contact
SUPPORT_EMAIL=support@swimacademy.com
SUPPORT_PHONE=+201234567890

# Logging & Monitoring
LOG_LEVEL=info
MONITORING_ENABLED=true
BACKUP_ENABLED=true

# Application Name
APP_NAME=Academy Multi M