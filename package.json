{
  "name": "academy-multi-m",
  "version": "4.0.0",
  "description": "Academy Multi M - Professional Academy Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:debug": "nodemon --inspect server.js",
    "build": "npm run build:production",
    "build:production": "NODE_ENV=production node server.js",
    "test": "NODE_ENV=test jest --forceExit --detectOpenHandles --verbose --coverage",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:auth": "NODE_ENV=test jest tests/auth.test.js --verbose",
    "test:users": "NODE_ENV=test jest tests/users.test.js --verbose",
    "test:subscriptions": "NODE_ENV=test jest tests/subscriptions.test.js --verbose",
    "test:sessions": "NODE_ENV=test jest tests/trainingSessions.test.js --verbose",
    "test:progress": "NODE_ENV=test jest tests/progress.test.js --verbose",
    "test:security": "NODE_ENV=test jest tests/security.test.js --verbose",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "docker:build": "docker build -t swim-academy-pro .",
    "docker:run": "docker run -p 5000:5000 swim-academy-pro",
    "docker:compose": "docker-compose up -d",
    "docs:generate": "swagger-jsdoc -d swaggerDef.js -o docs/",
    "docs:serve": "serve docs/",
    "seed": "node scripts/seedData.js",
    "clean:test": "NODE_ENV=test node scripts/cleanTestData.js",
    "monitor": "node scripts/monitor.js",
    "security:audit": "npm audit --audit-level=high",
    "security:fix": "npm audit fix",
    "db:backup": "node scripts/dbBackup.js",
    "db:restore": "node scripts/dbRestore.js",
    "deploy:staging": "node scripts/deploy.js --env=staging",
    "deploy:production": "node scripts/deploy.js --env=production"
  },
  "keywords": [
    "academy",
    "management",
    "saas",
    "courses",
    "enrollments",
    "nodejs",
    "express",
    "mongodb",
    "react",
    "api",
    "jwt",
    "production"
  ],
  "author": "Academy Multi M Team <support@academymultim.com>",
  "license": "MIT",
  "dependencies": {
    "archiver": "^6.0.1",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "compression": "^1.7.4",
    "connect-mongo": "^5.0.0",
    "cors": "^2.8.5",
    "csurf": "^1.2.2",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-brute": "^1.0.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.0",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.0",
    "geoip-lite": "^1.4.7",
    "helmet": "^7.0.0",
    "hpp": "^0.2.3",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "mongoose": "^8.0.0",
    "mongoose-paginate-v2": "^1.7.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.9",
    "otp-generator": "^4.0.1",
    "passport": "^0.6.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.14.0",
    "qrcode": "^1.5.3",
    "redis": "^4.6.7",
    "sharp": "^0.33.0",
    "socket.io": "^4.7.2",
    "speakeasy": "^2.0.0",
    "stripe": "^13.3.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "ua-parser-js": "^1.0.37",
    "unzipper": "^0.10.14",
    "user-agent": "^1.0.3",
    "uuid": "^9.0.1",
    "winston": "^3.10.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "artillery": "^2.0.26",
    "autocannon": "^7.15.0",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.6.4",
    "loadtest": "^8.2.0",
    "mock-fs": "^5.2.0",
    "nodemon": "^3.0.1",
    "nyc": "^15.1.0",
    "prettier": "^3.0.3",
    "supertest": "^6.3.3",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AhmedAbdelhamid12/Backends.git"
  },
  "bugs": {
    "url": "https://github.com/AhmedAbdelhamid12/Backends/issues"
  },
  "homepage": "https://github.com/academymultim/academy-multi-m#readme"
}
