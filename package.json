{
  "name": "swim-academy-backend",
  "version": "1.0.0",
  "description": "نظام إدارة أكاديمية السباحة واللياقة البدنية - تطبيق متكامل للويب والموبايل",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --forceExit --detectOpenHandles --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:auth": "jest tests/auth.test.js",
    "test:users": "jest tests/users.test.js",
    "test:subscriptions": "jest tests/subscriptions.test.js",
    "test:sessions": "jest tests/trainingSessions.test.js",
    "test:progress": "jest tests/progress.test.js",
    "seed": "node scripts/seedData.js",
    "build": "npm run build:production",
    "build:production": "NODE_ENV=production node server.js"
  },
  "keywords": [
    "swimming",
    "academy",
    "fitness",
    "management",
    "nodejs",
    "express",
    "mongodb",
    "react-native",
    "react",
    "ios",
    "android",
    "web"
  ],
  "author": "Swim Academy Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "mongoose": "^7.8.7",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.9"
  },
  "devDependencies": {
    "jest": "^29.6.4",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/swim-academy-backend"
  },
  "bugs": {
    "url": "https://github.com/your-username/swim-academy-backend/issues"
  },
  "homepage": "https://github.com/your-username/swim-academy-backend#readme"
}
